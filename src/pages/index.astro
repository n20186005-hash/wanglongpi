---
import BaseLayout from '../layouts/BaseLayout.astro';
import Weather from '../components/Weather.astro';
import PhotoCredit from '../components/PhotoCredit.astro';

export const prerender = true;

const title = '望龍埤開放時間、天氣與交通｜宜蘭員山環湖指南';
const description = '望龍埤（宜蘭員山）行前指南：官方08:00–18:00開放資訊、天氣預報、交通與停車查詢、環湖步道和歷史實景照片。出發前確認天候與現場公告。';

const siteUrl = Astro.site ? new URL('/', Astro.site).href : undefined;

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  ...(siteUrl ? { '@id': `${siteUrl}#attraction` } : {}),
  name: '望龍埤',
  alternateName: ['望龙埤', '軟埤'],
  description,
  ...(siteUrl ? { url: siteUrl } : {}),
  ...(siteUrl ? { image: [`${new URL('/images/wanglongpi-lake-main.jpg', siteUrl).href}`] } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: '枕山村坡城路',
    addressLocality: '員山鄉',
    addressRegion: '宜蘭縣',
    postalCode: '264',
    addressCountry: 'TW'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 24.7766,
    longitude: 121.6990972
  },
  openingHoursSpecification: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].map((day) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${day}`,
    opens: '08:00',
    closes: '18:00'
  })),
  hasMap: 'https://maps.app.goo.gl/KK4nDMoRzwuh9FoBA',
  sameAs: [
    'https://maps.app.goo.gl/KK4nDMoRzwuh9FoBA',
    'https://travel.yilan.gov.tw/zh-tw/attraction/410/'
  ]
};

const faqs = [
  { q: '望龍埤需要門票嗎？', a: '本次查閱的宜蘭縣官方景點頁未列門票或停車費，因此不保證免費。出發前向主管單位確認，停車、餐飲與個別服務依現場價目及使用規則辦理。' },
  { q: '望龍埤幾點開放？', a: '宜蘭縣政府旅遊網列出每日08:00–18:00（2026年10月29日查閱）。天候、維護及現場公告可能調整開放範圍；這不代表周邊店家採用相同時段。' },
  { q: '望龍埤適合停留多久？', a: '只走湖畔可安排約一至兩小時；若加上步道、拍照與用餐，安排半日會更從容。' },
  { q: '什麼時段最適合去望龍埤？', a: '上午或午後光線較柔和，也較適合散步與拍攝湖面倒影。冬季落羽松轉色時，景觀層次尤其明顯。' },
  { q: '可以搭大眾運輸到望龍埤嗎？', a: '搭車前請在宜蘭勁好行查詢「望龍埤」站與綠16等當日路線，確認上車站、行車方向、下車後步行路徑與最後回程。未核實當日業者班表前，不把舊路線或發車時間視為保證。' },
  { q: '望龍埤好停車嗎？', a: '景區周邊設有停車空間，但假日熱門時段容易較滿。建議提早抵達，並以現場交通引導與收費標示為準。' },
  { q: '雨天適合前往嗎？', a: '湖區雨後別有山霧氣氛，但石板、木棧與山徑可能濕滑；遇大雨、雷雨或步道封閉時不建議勉強進入山徑。' },
  { q: '望龍埤的名字由來是什麼？', a: '「埤」指天然或小型蓄水塘；「望龍」取意「雲從龍」古諺，反映農村對水與雨的期盼。在地另稱「軟埤」。' },
  { q: '落羽松什麼時候轉色？', a: '官方旅遊介紹提及冬季落羽松景觀，但未提供每年的固定轉色日期。葉況受當年天候影響，請先看近期官方資訊，不以歷史照片推定目前葉色。' },
  { q: '適合帶長輩或嬰兒車嗎？', a: '官方介紹提及石板、木棧步道，但不能據此保證全線無階梯或輪椅可通行。出發前確認停車點至目標路段的坡度、階差、路寬及維修情況；同行者有需要時安排短程折返。' },
  { q: '可以在湖邊餵魚或水鳥嗎？', a: '建議不要。外來飼料會改變野生動物習性並影響水質與生態，以觀察取代投餵最友善。' }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const photo1 = '/images/wanglongpi-lake-main.jpg';
const photo2 = '/images/wanglongpi-lake-view.jpg';
const photo3 = '/images/wanglongpi-summer.jpg';
const photo4 = '/images/wanglongpi-landscape.jpg';

const mapsUrl = 'https://maps.app.goo.gl/KK4nDMoRzwuh9FoBA';
const govTourismUrl = 'https://travel.yilan.gov.tw/zh-tw/attraction/410/';
const ratingValue = 4.3;
const reviewCount = 15034;
const reviewSyncMonth = '2026 年 10 月 29 日';
const reviewSourceNote = 'Google Maps評分4.3/5、15,034則評價，查閱日期2026年10月29日。這是第三方平台的日期快照，不是本指南收集的評價，數字不會自動更新。';
---
<BaseLayout {title} {description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-lake-950/78 text-white backdrop-blur-xl">
    <div class="section-shell flex h-18 items-center justify-between gap-5">
      <a href="#top" class="focus-ring flex items-center gap-3 rounded-lg" aria-label="回到望龍埤首頁">
        <img src="/favicon.svg" alt="" class="h-10 w-10" width="40" height="40" />
        <span class="display text-xl">望龍埤</span>
      </a>
      <nav class="hidden items-center gap-6 text-sm text-white/78 xl:flex" aria-label="主選單">
        <a class="focus-ring rounded hover:text-white" href="#explore">怎麼玩</a>
        <a class="focus-ring rounded hover:text-white" href="#seasons">季節</a>
        <a class="focus-ring rounded hover:text-white" href="#routes">路線</a>
        <a class="focus-ring rounded hover:text-white" href="#transport">交通</a>
        <a class="focus-ring rounded hover:text-white" href="#weather">天氣</a>
        <a class="focus-ring rounded hover:text-white" href="#services">服務</a>
        <a class="focus-ring rounded hover:text-white" href="#nearby">周邊</a>
        <a class="focus-ring rounded hover:text-white" href="#photos">相片</a>
        <a class="focus-ring rounded hover:text-white" href="#reviews">評價</a>
        <a class="focus-ring rounded hover:text-white" href="#faq">FAQ</a>
      </nav>
      <details class="mobile-menu xl:hidden"><summary>選單</summary><nav aria-label="手機主選單">{[['行前規劃','plan'],['交通','transport'],['天氣','weather'],['相片','photos'],['常見問題','faq'],['資料與隱私','sources']].map(([label,id])=><a href={'#'+id}>{label}</a>)}</nav></details>
      <a href="https://maps.app.goo.gl/KK4nDMoRzwuh9FoBA" target="_blank" rel="noopener noreferrer" class="focus-ring rounded-full bg-bridge px-4 py-2 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#c9513e]">開啟地圖</a>
    </div>
  </header>

  <main id="top">
    <section class="hero-photo relative flex min-h-[790px] flex-col justify-end overflow-hidden pt-28 text-white">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_72%_32%,transparent_0,rgba(8,25,18,.12)_28%,rgba(8,25,18,.46)_78%)]"></div>
      <div class="pointer-events-none absolute -bottom-24 right-[7%] h-80 w-80 rounded-full border border-white/15"></div>
      <div class="section-shell relative z-10 grid gap-10 pb-18 lg:grid-cols-[1.2fr_.8fr] lg:items-end lg:pb-24">
        <div>
          <p class="mb-5 text-sm font-bold tracking-[.28em] text-lake-100">宜蘭 · 員山 · 枕山</p>
          <h1 class="display max-w-4xl text-6xl leading-[1.04] sm:text-7xl lg:text-[7.3rem]">望龍埤</h1>
          <p class="display mt-4 max-w-2xl text-2xl leading-relaxed text-white/90 sm:text-3xl">一池山色，兩道朱橋。<br class="hidden sm:block" />把腳步放慢，讓宜蘭的綠意停在湖面上。</p>
          <div class="mt-8 flex flex-wrap gap-3 text-sm">
            <span class="rounded-full border border-white/30 bg-white/10 px-4 py-2 backdrop-blur">天然湖泊 · 又名「軟埤」</span>
            <span class="rounded-full border border-white/30 bg-white/10 px-4 py-2 backdrop-blur">九曲橋 · 望龍亭</span>
            <span class="rounded-full border border-white/30 bg-white/10 px-4 py-2 backdrop-blur">山林步道 · 半日慢旅</span>
          </div>
        </div>
        <aside class="card-shadow rounded-[2rem] border border-white/15 bg-lake-950/58 p-6 backdrop-blur-xl sm:p-8">
          <div class="flex items-center justify-between border-b border-white/14 pb-5">
            <div><p class="text-xs tracking-[.2em] text-white/55">旅遊資訊</p><p class="mt-1 text-xl font-bold">今天怎麼安排</p></div>
            <div class="text-right"><p class="text-xs text-white/55">Google Maps評分</p><p class="display text-3xl text-[#f4d58d]">4.3<span class="ml-1 text-sm text-white/60">/ 5</span></p><p class="mt-1 text-xs text-white/45">{reviewCount.toLocaleString('en-US')} 則評價</p></div>
          </div>
          <dl class="grid grid-cols-2 gap-x-5 gap-y-6 pt-6 text-sm">
            <div><dt class="text-white/48">開放時間</dt><dd class="mt-1 font-semibold">08:00–18:00</dd></div>
            <div><dt class="text-white/48">建議停留</dt><dd class="mt-1 font-semibold">1–2 小時 / 半日</dd></div>
            <div><dt class="text-white/48">門票</dt><dd class="mt-1 font-semibold">未核實現行費用</dd></div>
            <div><dt class="text-white/48">位置</dt><dd class="mt-1 font-semibold">員山鄉枕山村</dd></div>
          </dl><p class="mt-5 text-xs leading-6 text-white/70">時段來源：<a class="underline" href={govTourismUrl}>宜蘭縣政府旅遊網</a>。評分來源：<a class="underline" href={mapsUrl}>Google Maps</a>。查閱：2026年10月29日；開放範圍以現場公告為準。</p>
        </aside>
      </div>
      <div class="section-shell relative z-10 pb-6"><PhotoCredit photo={1} dark /></div>
    </section>

    <section class="paper-grain border-b border-lake-900/8 py-14">
      <div class="section-shell grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-3xl bg-white/70 p-6"><p class="eyebrow">Lake</p><p class="display mt-2 text-4xl text-lake-900">4–5 公頃</p><p class="mt-2 text-sm leading-6 text-lake-800/65">三面環山的狹長天然湖泊，水位與雨量關係密切。</p></div>
        <div class="rounded-3xl bg-white/70 p-6"><p class="eyebrow">Walk</p><p class="display mt-2 text-4xl text-lake-900">約 2.6 km</p><p class="mt-2 text-sm leading-6 text-lake-800/65">官方旅遊資料標示的環湖步道長度，石板與木棧交錯。</p></div>
        <div class="rounded-3xl bg-white/70 p-6"><p class="eyebrow">View</p><p class="display mt-2 text-4xl text-lake-900">朱橋映湖</p><p class="mt-2 text-sm leading-6 text-lake-800/65">九曲橋、紅色拱橋與湖中小島構成望龍埤最鮮明的畫面。</p></div>
        <div class="rounded-3xl bg-white/70 p-6"><p class="eyebrow">Season</p><p class="display mt-2 text-4xl text-lake-900">四季皆宜</p><p class="mt-2 text-sm leading-6 text-lake-800/65">春夏翠綠，冬季落羽松轉色；上午與午後更適合慢遊。</p></div>
      </div>
    </section>

    <section class="mountain-lines py-22 sm:py-28">
      <div class="section-shell grid gap-14 lg:grid-cols-[.86fr_1.14fr] lg:items-center">
        <div>
          <p class="eyebrow">The lake story · 湖的故事</p>
          <h2 class="display mt-4 text-4xl leading-tight text-lake-950 sm:text-5xl">「望龍」不是傳說的龍，<br />而是一份對雨水的盼望。</h2>
          <p class="mt-7 max-w-xl text-lg leading-9 text-lake-900/70">望龍埤位在枕山村，舊稱「軟埤」。地方資料記載，這座湖泊由山洪與土石沖刷自然形成，過去與居民生活及農作灌溉緊密相連。湖名取意於「風從虎，雲從龍」的古諺，也留下了人與水、農田與山林相依的地方記憶。</p>
          <div class="mt-8 border-l-2 border-bridge pl-5 text-sm leading-7 text-lake-800/62">這裡不是大型遊樂園式景點。真正適合它的玩法，是環湖、看橋、坐在水邊，或順著山徑再多走一段。</div>
        </div>
        <figure class="relative">
          <div class="absolute -left-5 -top-5 h-full w-full rounded-[2.5rem] border border-bridge/25"></div>
          <img src={photo4} alt="望龍埤（員山鄉, 宜蘭縣）湖面與朱橋實景" width="1000" height="562" loading="lazy" class="card-shadow relative aspect-[16/10] w-full rounded-[2.5rem] object-cover" />
          <figcaption><PhotoCredit photo={4} /></figcaption>
        </figure>
      </div>
    </section>

    <section id="heritage" class="py-22 sm:py-28">
      <div class="section-shell grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-start">
        <div>
          <p class="eyebrow">Heritage & ecology · 地景與記憶</p>
          <h2 class="display mt-4 text-4xl leading-tight text-lake-950 sm:text-5xl">不只是一座湖，<br />是一段農村與山林的關係。</h2>
          <p class="mt-6 text-base leading-8 text-lake-900/62">望龍埤能成為今天的樣子，來自水、農田與社區長年的相處。理解這層背景，會讓湖畔的每一步更有層次。</p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <article class="card-shadow rounded-[2rem] bg-white p-7"><p class="eyebrow">水利與農業</p><h3 class="display mt-3 text-2xl text-lake-950">從灌溉埤塘開始</h3><p class="mt-4 text-sm leading-7 text-lake-900/64">依官方介紹，湖水與雨量及當地農作灌溉關係密切；「望龍」二字取意「雲從龍」古諺，也承載農村對水與雨的期盼。</p></article>
          <article class="card-shadow rounded-[2rem] bg-white p-7"><p class="eyebrow">社區營造</p><h3 class="display mt-3 text-2xl text-lake-950">埤塘變成慢活的湖</h3><p class="mt-4 text-sm leading-7 text-lake-900/64">官方旅遊資料介紹環湖步道、橋與休憩空間。請尊重周邊居民及農作環境，停車與步行依現場引導。</p></article>
          <article class="card-shadow rounded-[2rem] bg-white p-7"><p class="eyebrow">民間傳說</p><h3 class="display mt-3 text-2xl text-lake-950">盼雨的名稱故事</h3><p class="mt-4 text-sm leading-7 text-lake-900/64">官方資料以「風從虎，雲從龍」解釋湖名，反映農村盼雨的心情。名稱故事與現代天氣預報不同，請另看當日氣象資訊。</p></article>
          <article class="card-shadow rounded-[2rem] bg-white p-7"><p class="eyebrow">生態基底</p><h3 class="display mt-3 text-2xl text-lake-950">水鳥與落羽松</h3><p class="mt-4 text-sm leading-7 text-lake-900/64">官方介紹提到水鳥、魚群與冬季落羽松景觀。能否觀察到動物與葉色取決於當日條件，請保持距離，不承諾固定物種或出現時段。</p></article>
        </div>
      </div>
    </section>

    <section id="explore" class="bg-lake-950 py-22 text-white sm:py-28">
      <div class="section-shell">
        <div class="max-w-3xl">
          <p class="eyebrow !text-[#e58b78]">Four ways to slow down · 四種慢玩法</p>
          <h2 class="display mt-4 text-4xl sm:text-5xl">沿著水走，也沿著山看。</h2>
          <p class="mt-5 text-lg leading-8 text-white/62">不用趕行程。先從湖邊開始，再依體力決定是否把路線拉進山林。</p>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-[2rem] border border-white/10 bg-white/[.055] p-7"><span class="display text-5xl text-white/18">01</span><h3 class="mt-6 text-xl font-bold">環湖慢行</h3><p class="mt-3 text-sm leading-7 text-white/58">石板、木棧與湖岸交替，最適合第一次到訪，也適合親子與長輩。</p></article>
          <article class="rounded-[2rem] border border-white/10 bg-white/[.055] p-7"><span class="display text-5xl text-[#d76a55]">02</span><h3 class="mt-6 text-xl font-bold">九曲橋・望龍亭</h3><p class="mt-3 text-sm leading-7 text-white/58">走上湖中小島，從朱紅橋身尋找倒影，是望龍埤最具識別度的視角。</p></article>
          <article class="rounded-[2rem] border border-white/10 bg-white/[.055] p-7"><span class="display text-5xl text-white/18">03</span><h3 class="mt-6 text-xl font-bold">飛龍・挑夫步道</h3><p class="mt-3 text-sm leading-7 text-white/58">想多一點運動量，可接上山徑；官方資料建議預留約 30–50 分鐘。</p></article>
          <article class="rounded-[2rem] border border-white/10 bg-white/[.055] p-7"><span class="display text-5xl text-white/18">04</span><h3 class="mt-6 text-xl font-bold">季節顏色</h3><p class="mt-3 text-sm leading-7 text-white/58">春夏看濃綠與水光；冬季留意落羽松轉色，讓紅黃綠與橋色彼此呼應。</p></article>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <figure class="md:col-span-2"><img src={photo1} alt="望龍埤九曲橋與湖岸綠意（員山鄉）" width="3593" height="2021" loading="lazy" class="h-72 w-full rounded-[2rem] object-cover" /><figcaption><PhotoCredit photo={1} dark /></figcaption></figure>
          <figure><img src={photo3} alt="望龍埤夏季樹影與湖面（宜蘭縣員山鄉）" width="3264" height="1952" loading="lazy" class="h-72 w-full rounded-[2rem] object-cover" /><figcaption><PhotoCredit photo={3} dark /></figcaption></figure>
        </div>
      </div>
    </section>

    <section id="seasons" class="bg-lake-50 py-22 sm:py-28">
      <div class="section-shell">
        <div class="max-w-3xl">
          <p class="eyebrow">Seasonal strategy · 四季遊覽策略</p>
          <h2 class="display mt-4 text-4xl text-lake-950 sm:text-5xl">什麼時候去，<br />決定你看到什麼。</h2>
          <p class="mt-5 text-base leading-8 text-lake-900/62">下表以宜蘭平地近 30 年氣候常態（climate normals）為基礎概括，並結合望龍埤湖域的水位、水質與物候觀察；實際天氣請以中央氣象署當日預報為準。</p>
        </div>

        <div class="mt-10 overflow-x-auto rounded-[2rem] border border-lake-900/10 bg-white">
